# Copy to .env.production, fill every REPLACE value, never commit that file.
# Always pass --env-file .env.production; exported shell values take precedence.
POSTGRES_DB=fate
POSTGRES_USER=fate
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
# Encode credentials as URL components. Both URLs must match POSTGRES_* above.
# postgres is Docker DNS, not localhost. For this direct DB both URLs are equal.
DATABASE_URL=postgresql://fate:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/fate
DIRECT_URL=postgresql://fate:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/fate
# Generate two independent keys of at least 32 UTF-8 bytes; placeholders are NOT keys.
JWT_ACCESS_SECRET=REPLACE_ACCESS_KEY
JWT_REFRESH_SECRET=REPLACE_REFRESH_KEY
WEB_ORIGIN=https://fate.example.com
AUTH_COOKIE_SAME_SITE=none
SERVER_BIND_ADDRESS=127.0.0.1
SERVER_PORT=3000
# NODE_ENV=production, PORT=3000, ENABLE_TEST_ROOMS=false and one server process
# are fixed by compose.yml. Optional application controls are documented in
# docs/production-environment.md; omit them to retain defaults.
