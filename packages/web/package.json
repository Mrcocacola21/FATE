    "test:assets": "tsx --test src/assets/unitVisuals.test.ts src/assets/boardFields.test.tsx src/components/BoardMarkers.test.tsx",
    "test:placement": "tsx --test src/game/components/RightPanel/sections/PlacementSection.test.tsx",
    "test:players": "tsx --test src/game/gameshell-content/components/SidePanelTabs.test.tsx",
    "test:effects": "tsx --test src/game/effects/*.test.ts src/features/vfx/*.test.ts src/features/vfx/*.test.tsx src/pages/VfxPreviewPage.test.tsx",
    "test:sfx": "tsx --test src/assets/sfx/*.test.ts src/features/sfx/*.test.ts",
    "test:vfx": "tsx --test src/features/vfx/*.test.ts src/features/vfx/*.test.tsx src/pages/VfxPreviewPage.test.tsx",
    "test:vfx:visual": "node scripts/capture-vfx.mjs --no-video --no-gif",
    "test:test-room": "tsx --test src/testRoom/*.test.ts",
    "capture:vfx": "node scripts/capture-vfx.mjs",
    "check:i18n": "npm run typecheck && npm run test:i18n",
    "preview": "vite preview",
    "test:profile": "tsx --test src/profile/*.test.ts src/profile/*.test.tsx",
    "test:profile:e2e": "node scripts/auth-smoke.mjs",
    "test:matches": "tsx --test src/matches/*.test.ts src/matches/*.test.tsx",
    "test:matches:e2e": "node scripts/match-history-smoke.mjs",
    "test:matchmaking": "tsx --test src/matchmaking/*.test.ts src/matchmaking/*.test.tsx",
    "test:matchmaking:e2e": "node scripts/matchmaking-smoke.mjs",
    "test:rating:modes:e2e": "node scripts/per-mode-ratings-smoke.mjs"
