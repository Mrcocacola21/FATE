  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.1.0",
    "react-router": "^7.18.4",
    "rules": "file:../rules",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/react-test-renderer": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "playwright-core": "^1.61.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.36",
    "react-test-renderer": "^18.3.1",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.1",
    "tsx": "4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.2.0"
