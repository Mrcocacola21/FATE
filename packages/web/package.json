    "test:statistics:e2e": "tsx scripts/statistics-smoke.mjs",
    "test:replay": "tsx --test src/replay/*.test.tsx",
    "test:replay:e2e": "node scripts/replay-smoke.mjs",
    "dev": "vite",
    "build": "vite build",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:auth": "tsx --test src/auth/*.test.ts src/auth/*.test.tsx",
    "test:shell": "tsx --test src/layout/AppShell.test.tsx src/lobby/*.test.tsx",
