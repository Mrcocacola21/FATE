{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:ranks": "tsx --test src/ranks/*.test.ts src/ranks/*.test.tsx",
    "test:ranks:e2e": "tsx scripts/rank-emblems-smoke.mjs",
    "test:play-lobby:e2e": "node scripts/play-lobby-smoke.mjs",
    "test:match-types:e2e": "node scripts/match-types-smoke.mjs",
