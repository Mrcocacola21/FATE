{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test:ranks": "tsx --test src/tests/rankTiers.test.ts",
    "test:lobby": "tsx src/tests/lobby.test.ts",
    "test:match-types": "tsx src/tests/matchTypes.test.ts",
    "test:match-types:db": "tsx src/tests/matchTypes.integration.test.ts",
    "test:leaderboard": "tsx src/tests/leaderboard.test.ts",
    "pretest:leaderboard:db": "npm run prisma:generate",
    "test:leaderboard:db": "tsx src/tests/leaderboard.integration.test.ts",
    "test:rating": "tsx src/tests/rating.test.ts",
    "pretest:rating:db": "npm run prisma:generate",
    "test:rating:db": "tsx src/tests/rating.integration.test.ts",
    "test:statistics": "tsx src/tests/playerStatistics.test.ts",
    "pretest:statistics:db": "npm run prisma:generate",
    "test:statistics:db": "tsx src/tests/playerStatistics.integration.test.ts",
    "test:replay-api": "tsx src/tests/replayApi.test.ts",
    "test:replay-api:db": "tsx src/tests/replayApi.integration.test.ts",
    "dev:raw": "tsx watch src/index.ts",
    "dev": "node ../../scripts/waitForRulesDist.mjs && npm run dev:raw",
    "prebuild": "npm run prisma:generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:deploy": "npm run db:migrate:deploy && npm run db:migrate:status && npm run start",
    "pretest": "npm run prisma:generate",
    "test": "npm run -w rules build && tsx src/tests/deployment.test.ts && tsx src/tests/databaseFoundation.test.ts && tsx src/tests/auth.test.ts && tsx src/tests/profile.test.ts && tsx src/tests/view.test.ts && tsx src/tests/markerProjection.test.ts && tsx src/tests/matchLifecycle.test.ts && tsx src/tests/matchTypes.test.ts && tsx src/tests/lobby.test.ts && tsx src/tests/matchmaking.test.ts && tsx src/tests/matchmaking.ws.test.ts && tsx src/tests/matchResult.test.ts && tsx src/tests/matchHistory.test.ts && tsx src/tests/playerStatistics.test.ts && tsx src/tests/rating.test.ts && npm run test:ranks && tsx src/tests/leaderboard.test.ts && tsx src/tests/matchAction.test.ts && tsx src/tests/matchSnapshot.test.ts && tsx src/tests/replay.test.ts && tsx src/tests/matchRecovery.test.ts && tsx src/tests/authenticatedMultiplayer.test.ts && tsx src/tests/ws.smoke.ts && tsx src/tests/hardening.test.ts && tsx src/tests/testRoom.test.ts && tsx src/tests/testRoom.ws.test.ts && tsx src/tests/modes.test.ts",
    "pretest:db": "npm run prisma:generate",
    "test:db": "tsx src/tests/database.integration.test.ts",
    "pretest:auth:db": "npm run prisma:generate",
    "test:auth:db": "tsx src/tests/auth.integration.test.ts",
    "prisma:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "test:profile": "tsx src/tests/profile.test.ts",
    "pretest:profile:db": "npm run prisma:generate",
    "test:profile:db": "tsx src/tests/profile.integration.test.ts",
    "pretest:match:db": "npm run prisma:generate",
    "test:match:db": "tsx src/tests/match.integration.test.ts",
    "pretest:results:db": "npm run prisma:generate",
    "test:results:db": "tsx src/tests/matchResult.integration.test.ts",
    "pretest:actions:db": "npm run prisma:generate",
    "test:actions:db": "tsx src/tests/matchAction.integration.test.ts",
    "test:history:db": "tsx src/tests/matchHistory.integration.test.ts",
    "pretest:history:db": "npm run prisma:generate",
    "test:snapshots": "tsx src/tests/matchSnapshot.test.ts",
    "pretest:snapshots:db": "npm run prisma:generate",
    "test:snapshots:db": "tsx src/tests/matchSnapshot.integration.test.ts",
    "test:replay": "tsx src/tests/replay.test.ts",
    "test:recovery": "tsx src/tests/matchRecovery.test.ts",
    "test:recovery:db": "tsx src/tests/matchRecovery.integration.test.ts",
    "pretest:replay:db": "npm run prisma:generate",
    "test:replay:db": "tsx src/tests/replay.integration.test.ts",
    "test:matchmaking": "tsx src/tests/matchmaking.test.ts && tsx src/tests/matchmaking.ws.test.ts",
    "test:matchmaking:db": "tsx src/tests/matchmaking.integration.test.ts",
    "test:rating:modes:db": "tsx src/tests/perModeRatings.integration.test.ts && tsx src/tests/perModeMigration.integration.test.ts",
    "db:rating:inventory": "node ../../scripts/ratingMigrationInventory.cjs"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.1",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.45.1",
    "fastify": "^4.26.2",
    "jsonwebtoken": "^9.0.3",
    "rules": "file:../rules",
    "ws": "^8.16.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.30",
    "@types/ws": "^8.18.1",
    "prisma": "^6.19.0",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3"
  }
}
