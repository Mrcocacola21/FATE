generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum MatchSeat {
  P1
  P2
}

enum MatchOutcome {
  WIN
  LOSS
  DRAW
}

enum ProfileLanguage {
  en
  uk
}

enum ProfileTheme {
  light
  dark
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum AuditEventType {
  USER_BLOCKED
  USER_UNBLOCKED
  USER_ROLE_CHANGED
  MATCH_INTERRUPTED
}

enum AuditActorType {
  USER
  SYSTEM
}

// Historical identifiers intentionally have no cascading relations. They survive deletion
// of the referenced resource; the read service resolves current display identities separately.
model AuditLog {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType    AuditEventType
  actorType    AuditActorType
  actorUserId  String?        @db.Uuid
  actorRole    UserRole?
  targetUserId String?        @db.Uuid
  matchId      String?        @db.Uuid
  reason       String?        @db.VarChar(500)
  metadata     Json           @db.JsonB
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([createdAt, id])
  @@index([eventType, createdAt, id])
  @@index([actorUserId, createdAt, id])
  @@index([targetUserId, createdAt, id])
  @@index([matchId, createdAt, id])
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(320)
  passwordHash String?  @db.Text
  role         UserRole @default(USER)
  blockedAt    DateTime? @db.Timestamptz(3)
  blockedReason String? @db.VarChar(500)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  profile           Profile?
  ratings           Rating[]
  legacyGlobalRating LegacyGlobalRating?
  ratingHistory     RatingHistory[]
  opponentRatingHistory RatingHistory[] @relation("RatingHistoryOpponent")
  matchParticipants MatchParticipant[]
  createdMatches    Match[]            @relation("MatchCreator")
  wonMatches        Match[]            @relation("MatchWinner")
  lostMatches       Match[]            @relation("MatchLoser")
  matchActions      MatchAction[]      @relation("MatchActionActor")
  authSessions      AuthSession[]

  @@index([role])
  @@index([blockedAt])
  @@index([createdAt, id])
}

model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @db.Char(64)
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  lastUsedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Profile {
  userId      String   @id @db.Uuid
  username    String   @unique @db.VarChar(50)
  displayName String?  @db.VarChar(100)
  avatarUrl   String?  @db.Text
  preferredLanguage ProfileLanguage @default(en)
  preferredTheme ProfileTheme @default(light)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Match {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId        String?     @unique @db.Text
  status        MatchStatus @default(WAITING)
  isRated       Boolean     @default(false)
  ratingProcessedAt DateTime? @db.Timestamptz(3)
  gameMode      String      @db.VarChar(50)
  seed          Int
  initialConfig Json?       @db.JsonB
  createdById   String?     @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  startedAt     DateTime?   @db.Timestamptz(3)
  finishedAt    DateTime?   @db.Timestamptz(3)
  winnerUserId  String?     @db.Uuid
  winnerSeat    MatchSeat?
  loserUserId   String?     @db.Uuid
  loserSeat     MatchSeat?
  durationMs    Int?
  turnCount     Int?
  finishReason  String?     @db.Text
  finalRevision Int?
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  createdBy     User?              @relation("MatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  winner        User?              @relation("MatchWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  loser         User?              @relation("MatchLoser", fields: [loserUserId], references: [id], onDelete: SetNull)
  participants  MatchParticipant[]
  actions       MatchAction[]
  snapshots     MatchSnapshot[]
  ratingHistory RatingHistory[]

  @@index([status, createdAt])
  @@index([createdById])
  @@index([winnerUserId])
  @@index([loserUserId])
  @@index([isRated, status, ratingProcessedAt])
  @@index([createdAt, id])
  @@index([finishedAt, id])
  @@index([gameMode, isRated, createdAt])
}

model MatchParticipant {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId             String    @db.Uuid
  userId              String?   @db.Uuid
  seat                MatchSeat
  displayNameSnapshot String    @db.VarChar(100)
  outcome             MatchOutcome?
  resultData          Json?     @db.JsonB
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([matchId, seat])
  @@unique([matchId, userId])
  @@index([userId])
}

model MatchAction {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId       String     @db.Uuid
  revision      Int
  actorUserId   String?    @db.Uuid
  actorSeat     MatchSeat?
  actionType    String     @db.VarChar(100)
  actionPayload Json       @db.JsonB
  events        Json?      @db.JsonB
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)

  match     Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  actorUser User? @relation("MatchActionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([matchId, revision])
  @@index([actorUserId])
  @@index([actionType])
}

model MatchSnapshot {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId       String   @db.Uuid
  revision      Int
  state         Json     @db.JsonB
  rngState      Json?    @db.JsonB
  formatVersion Int      @default(1)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, revision])
}

model Rating {
  userId          String   @db.Uuid
  gameMode        String   @db.VarChar(50)
  rating          Float    @default(1500)
  ratingDeviation Float    @default(350)
  volatility      Float    @default(0.06)
  ratedGames      Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gameMode])
  @@index([gameMode, rating(sort: Desc)])
}

model LegacyGlobalRating {
  userId          String   @id @db.Uuid
  rating          Float    @default(1500)
  ratingDeviation Float    @default(350)
  volatility      Float    @default(0.06)
  ratedGames      Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

}

model RatingHistory {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @db.Uuid
  matchId               String?  @db.Uuid
  opponentUserId        String?  @db.Uuid
  result                MatchOutcome?
  ratedGameNumber       Int?
  // Null identifies the preserved legacy global stream, never a mode rating.
  gameMode              String?  @db.VarChar(50)
  ratingBefore          Float
  ratingAfter           Float
  ratingDeviationBefore Float
  ratingDeviationAfter  Float
  volatilityBefore      Float
  volatilityAfter       Float
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  match Match? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  opponent User? @relation("RatingHistoryOpponent", fields: [opponentUserId], references: [id], onDelete: SetNull)

  @@unique([userId, matchId])
  @@unique([userId, gameMode, ratedGameNumber])
  @@index([userId, gameMode, createdAt])
  @@index([matchId])
  @@index([opponentUserId])
}
