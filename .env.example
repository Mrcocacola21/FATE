# Local defaults
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
VITE_ENABLE_TEST_ROOM=true
WEB_ORIGIN=http://localhost:5173
FATE_DEBUG_TOKEN=dev-debug-token
ENABLE_TEST_ROOMS=true
ROOM_TTL_MS=86400000
MAX_ROOMS=100
MAX_LOG_EVENTS=5000
DATABASE_URL=postgresql://fate:fate@localhost:5432/fate?schema=public

# Auth requires two different random keys of at least 32 UTF-8 bytes.
# Generate each independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No fallback keys are used, including in development. Export these to the server process.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Default: lax in development, none in production (Render server / Vercel web).
# Allowed: lax, strict, none. none requires production Secure cookies / HTTPS.
# AUTH_COOKIE_SAME_SITE=lax
# Explicitly isolated test database/schema; apply migrations there before running test:auth:db.
# TEST_DATABASE_URL=postgresql://fate:fate@localhost:5432/fate_auth_test?schema=public
