# Placeholders only. Fill in your own environment; never commit values.
# The server reads exported process variables; it does not load the root .env.
# Vite reads packages/web/.env.local (public frontend configuration only).
NODE_ENV=
DATABASE_URL=
DIRECT_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
WEB_ORIGIN=
AUTH_COOKIE_SAME_SITE=
ENABLE_TEST_ROOMS=

# Production requires NODE_ENV=production and all five DB/JWT/origin variables above.
# Render: DATABASE_URL = Neon pooled; DIRECT_URL = Neon direct (same branch/database).
# Use independent JWT keys of at least 32 UTF-8 bytes and an exact HTTPS WEB_ORIGIN.
# Vercel/Render auth: AUTH_COOKIE_SAME_SITE=none; ENABLE_TEST_ROOMS=false.
# Local PostgreSQL: set DIRECT_URL equal to DATABASE_URL; no Neon dependency.
# Local defaults: WEB_ORIGIN http://localhost:5173; SameSite lax; test rooms enabled.
# Render supplies PORT. Omit optional controls to use existing defaults.
PORT=
FATE_DEBUG_TOKEN=
ROOM_TTL_MS=
MAX_ROOMS=
MAX_LOG_EVENTS=
# Optional, non-secret Render override. Omit for default 20 revisions.
# 0 disables periodic snapshots; completed matches still save a final snapshot.
MATCH_SNAPSHOT_INTERVAL=20
JWT_ACCESS_TTL_SECONDS=
JWT_REFRESH_TTL_SECONDS=

# Public build configuration ONLY; all VITE_* values are visible to browsers.
VITE_API_URL=
VITE_WS_URL=
VITE_ENABLE_TEST_ROOM=
# Local web: API http://localhost:3000; WS ws://localhost:3000/ws.
# Production web: HTTPS API, WSS /ws, VITE_ENABLE_TEST_ROOM=false.

# Local integration tests: loopback host and a database/schema with a 'test' name segment.
# Set BOTH DATABASE_URL and DIRECT_URL to this isolated target before test migrations.
TEST_DATABASE_URL=
